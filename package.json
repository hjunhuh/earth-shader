{
  "name": "earth-shader",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 4173 --strictPort",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --project unit",
    "test:gpu": "vitest run --project gpu",
    "test:e2e": "playwright test --project=metal",
    "test:e2e:ci": "playwright test --project=swiftshader",
    "bench": "playwright test --project=bench",
    "test:all": "npm run typecheck && npm test && npm run test:gpu && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "lil-gui": "0.21.0",
    "three": "0.186.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "@types/three": "0.186.0",
    "@vitest/browser-playwright": "5.0.5",
    "astronomy-engine": "^2.1.19",
    "fast-check": "4.10.2",
    "playwright": "1.64.1",
    "typescript": "7.0.2",
    "vite": "^8.3.5",
    "vitest": "5.0.5"
  }
}
